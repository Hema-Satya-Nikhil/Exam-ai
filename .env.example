# Copy this file to `.env` and fill in real values.
# Never commit real credentials. Secrets live only in the local `.env`.
DATABASE_URL=postgresql+asyncpg://db_user:db_password@db_host:5432/db_name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=question_paper_generator
# NVIDIA API access — keep this value in the backend environment only.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
APP_ENV=development
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_UPLOAD_SIZE=52428800
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3
CORS_ORIGINS=http://localhost:3000