# Copy this file to the environment file and fill in real values.
# Never commit real credentials.
DATABASE_URL=postgresql+asyncpg://db_user:db_password@db_host:5432/db_name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=question_paper_generator
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
APP_ENV=development
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_UPLOAD_SIZE=52428800
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3
CORS_ORIGINS=http://localhost:3000

# --- Password reset / Resend email delivery (backend-only secret) ----------
# RESEND_API_KEY is a BACKEND secret — never expose it to the frontend, never
# commit a real value. Replace locally with your real Resend key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=ExamCraft AI
# Select "brevo" for the temporary Brevo delivery test.
EMAIL_PROVIDER=resend
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ExamCraft AI
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_EXPIRE=604800